{
  "timezone": "America/Los_Angeles",

  "paths": {
    "lgsm_config": "/home/rustserver/lgsm/config-lgsm/rustserver/rustserver.cfg",
    "server_cfg": "/home/rustserver/serverfiles/server/rustserver/cfg/server.cfg",
    "state_file": "/opt/rust-autowipe/state/state.json",
    "backup_dir": "/opt/rust-autowipe/backups"
  },

  "updates": {
    "rust_update_enabled": true,
    "oxide_update_enabled": true,
    "lgsm_script": "/home/rustserver/rustserver"
  },

  "server_defaults": {
    "name": "Example Rust Server | Monthly Wipes",
    "ip_display": "203.0.113.10:28015",
    "discord": "https://discord.gg/yourserver",
    "website": "https://example.com",
    "header_image": "https://example.com/header.jpg",
    "tags": "monthly,vanilla,NA",
    "gamemode": "vanilla",
    "level": "Procedural Map",
    "max_players": 100,
    "save_interval": 600,
    "tickrate": 30
  },

  "rcon": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 28016,
    "password": "CHANGE_ME",
    "command_delay_seconds": 2
  },

  "post_start": {
    "wait_seconds_after_start": 180,
    "server_commands": [
      "say Server wipe complete. Welcome to the new wipe!",
      "server.writecfg"
    ],
    "custom_script": {
      "enabled": false,
      "path": "/opt/rust-autowipe/scripts/custom_post_wipe.sh"
    }
  },

